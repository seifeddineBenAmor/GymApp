# Database — matches docker-compose.yml service name "db"
DATABASE_URL=postgresql+asyncpg://urbangym:urbangym@db:5432/urbangym

# JWT — change this before deploying anywhere
SECRET_KEY=change_this_to_a_long_random_string_before_deploying

# CORS — Vite dev server
ALLOWED_ORIGINS=["http://localhost:5173"]

# Postgres (used by docker-compose db service)
POSTGRES_USER=urbangym
POSTGRES_PASSWORD=urbangym
POSTGRES_DB=urbangym
